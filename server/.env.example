# Server Port
PORT=5001

# Google Gemini Configuration
# Provide your Gemini API key below. If missing or invalid, the server automatically
# falls back to a deterministic Mock LLM so the application and tests remain 100% operational.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mock LLM toggle (set to true to force deterministic mock mode even if key is present)
MOCK_LLM=false

